# ==============================================================================
# Nirman AI — Production Environment Variables Template
# Copy this file to .env and replace placeholder values with secure secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (format: postgresql://<user>:<password>@<host>:<port>/<dbname>)
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/nirman_db

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (Secret: DO NOT COMMIT REAL KEY)
JWT_SECRET_KEY=replace_with_a_strong_random_secret_hex_64_chars

# Access token expiration in minutes (Default: 720 = 12 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# 3. AI & GEMINI COPILOT CONFIGURATION (Required for Copilot Chat)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Copilot v2 Query Planner & Grounded Chat (Secret)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Target Gemini model version (Default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 4. NOTIFICATION & SMTP EMAIL CONFIGURATION (Optional - Graceful Degraded Mode)
# ------------------------------------------------------------------------------
# Email provider type (Default: SMTP)
EMAIL_PROVIDER=SMTP

# Outbound SMTP Mail Host server (e.g. smtp.gmail.com or email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=smtp.example.com

# Outbound SMTP Mail Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP Authentication Username / Credential (Secret)
SMTP_USERNAME=notifications@nirman.gov.in

# SMTP Authentication Password / App Password (Secret)
SMTP_PASSWORD=your_secure_smtp_password

# Enable STARTTLS encryption (true/false)
SMTP_USE_TLS=true

# Enable SSL direct encryption (true/false)
SMTP_USE_SSL=false

# Sender email address displayed to recipients (supports SMTP_FROM_EMAIL or legacy EMAIL_FROM)
SMTP_FROM_EMAIL=notifications@nirman.gov.in
EMAIL_FROM=notifications@nirman.gov.in

# Sender display name (supports SMTP_FROM_NAME or legacy EMAIL_FROM_NAME)
SMTP_FROM_NAME=Nirman AI Risk System
EMAIL_FROM_NAME=Nirman AI Risk System

# ------------------------------------------------------------------------------
# 5. SERVER & CORS CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Comma-separated CORS allowed origins for frontend web application
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
